{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/bitdefender", "destination": "/compliance", "permanent": false },
    { "source": "/bitdefender/", "destination": "/compliance", "permanent": false },
    { "source": "/servicios", "destination": "/compliance", "permanent": false },
    { "source": "/servicios/", "destination": "/compliance", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/compliance",
      "destination": "/compliance/index.html"
    },
    {
      "source": "/compliance/",
      "destination": "/compliance/index.html"
    },
    {
      "source": "/gracias",
      "destination": "/gracias/index.html"
    },
    {
      "source": "/gracias/",
      "destination": "/gracias/index.html"
    },
    {
      "source": "/((?!api|assets|compliance|gracias|favicon\\.svg|logo-iso\\.png|lottie-shield\\.json|robots\\.txt|site\\.webmanifest|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/imagery/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|svg|webp|avif))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/lottie-shield.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ]
}
